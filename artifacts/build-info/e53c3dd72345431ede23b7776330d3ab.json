			"Code Eater/Type/DataType.sol": {
				"content": "// SPDX-License-Identifier: MIT\r\npragma solidity ^0.8.34;\r\n\r\nstruct FreelancerPofile {\r\n    string name;\r\n    uint ID;\r\n    bool isActive;\r\n    uint experienceYear;\r\n    address wallet;\r\n}\r\n\r\nstruct jobListingInput {\r\n    string title;\r\n    string jobDiscription;\r\n    uint dedline;\r\n    uint price;\r\n}\r\n\r\nstruct JobListing {\r\n    uint id;\r\n    string title;\r\n    string jobDiscription;\r\n    uint dedline;\r\n    uint price; \r\n    bool isOpen;\r\n    bool hasHierdFreelancer;\r\n    uint hierdFrelancerID;\r\n    bool isPaid;\r\n}\r\n\r\nstruct employee {\r\n    string name;\r\n    uint id;\r\n    bool inHaiard;\r\n    address wallet;\r\n    JobListing [ ] jobListings;\r\n    }"
			}
		}
